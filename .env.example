# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Public base URL (used for invite links). e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Auth.js — generate with: node -e "console.log(require('crypto').randomBytes(33).toString('base64'))"
AUTH_SECRET=
