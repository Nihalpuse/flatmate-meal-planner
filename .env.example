# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Public base URL (used for invite links). e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Auth.js — generate with: node -e "console.log(require('crypto').randomBytes(33).toString('base64'))"
AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
# Leave blank to hide the "Continue with Google" button.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Upstash Redis — https://console.upstash.com (create a database, copy the REST creds)
# Makes rate limits hold across all server instances. Without these, limiting falls
# back to per-process memory, which a multi-instance deployment bypasses by simply
# landing on another instance — leaving the paid Gemini endpoints unprotected.
# Leave blank for local dev and single-instance deployments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend — https://resend.com (add a domain, verify its DNS, then create an API key)
# Sends the signup confirmation email. Required in production: without it, new accounts
# can never confirm their address and so can never create or join a flat.
# Leave blank in local dev — the email is printed to the server console instead, so the
# whole signup -> verify flow still works without owning a sending domain.
# EMAIL_FROM must be an address on the domain you verified, e.g. "Aaj Kya Banega
# <hello@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=
